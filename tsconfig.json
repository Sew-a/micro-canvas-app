{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*", "./*"],
      "components/*": ["./src/components/*"],
      "context/*": ["./src/contexts/*"],
      "hooks/*": ["./src/hooks/*"],
      "lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
